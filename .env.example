GITHUB_APP_ID=123456
# Production hosts should use the multiline secret below. Local development may
# use GITHUB_PRIVATE_KEY_PATH instead.
GITHUB_PRIVATE_KEY=
GITHUB_PRIVATE_KEY_PATH=/absolute/path/to/qnode-repo-auditor.private-key.pem
GITHUB_INSTALLATION_ID=12345678
# Optional: increases the public scanner's GitHub API rate limit.
GITHUB_PUBLIC_TOKEN=
GITHUB_WEBHOOK_SECRET=replace-with-at-least-32-random-bytes
# Optional private owner dashboard at /owner/metrics; use a unique random secret.
OWNER_METRICS_TOKEN=
OWNER_METRICS_USERNAME=Kxrma47
# Optional durable private counts on Render Free (Neon/PostgreSQL). Keep this secret.
VISITOR_METRICS_URL=
# Local development alternative only; do not set both metrics backends.
VISITOR_METRICS_DB=
PUBLIC_AUDIT_ENABLED=true
AUDIT_CACHE_SECONDS=300
PORT=8000
